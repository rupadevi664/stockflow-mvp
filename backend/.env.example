APP_NAME=StockFlow MVP
APP_VERSION=1.0.0
DEBUG=False

# Option 1: Full Database URL (Recommended for Cloud Providers like Aiven, AWS RDS, Railway)
# DATABASE_URL=mysql+pymysql://username:password@host:3306/stockflow_db

# Option 2: Individual Connection Parameters
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=stockflow_db
DATABASE_USER=root
DATABASE_PASSWORD=your_secure_password

# Authentication & Security
SECRET_KEY=generate_a_64_character_random_hex_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Production CORS (Comma-separated allowed frontend origins or * for open)
CORS_ORIGINS=http://localhost:5173,https://stockflow.vercel.app
